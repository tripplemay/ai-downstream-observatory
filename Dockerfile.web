FROM node:22-alpine AS dependencies
WORKDIR /app/web
RUN apk add --no-cache python3 make g++
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM dependencies AS production-dependencies
RUN npm prune --omit=dev --no-audit --no-fund

FROM dependencies AS builder
WORKDIR /app/web
COPY contracts/ /app/contracts/
COPY migrations/ /app/migrations/
COPY scripts/ /app/scripts/
COPY worker/accounting/ /app/worker/accounting/
COPY worker/market/ /app/worker/market/
COPY worker/orchestration/ /app/worker/orchestration/
COPY worker/performance/ /app/worker/performance/
COPY worker/research/ /app/worker/research/
COPY worker/governance_verification/ /app/worker/governance_verification/
COPY requirements-workbench.txt /app/requirements-workbench.txt
COPY tests/deployment/build-verification-smoke.mjs tests/deployment/verification-container-bridge.ts /app/tests/deployment/
COPY web/ ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build && npm run build:verification-worker && node /app/tests/deployment/build-verification-smoke.mjs

FROM node:22-alpine AS runner
ARG RELEASE_SHA=development
LABEL org.opencontainers.image.revision=$RELEASE_SHA
WORKDIR /app/web
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0 \
    WORKBENCH_DB_PATH=/app/data/etf-workbench.db \
    WORKBENCH_DATA_DIR=/app/data
RUN addgroup -g 10001 workbench && adduser -D -u 10001 -G workbench workbench
COPY --from=builder --chown=10001:10001 /app/web/.next/standalone ./
COPY --from=builder --chown=10001:10001 /app/web/.next/static ./.next/static
# Operational tools use the same pinned production modules as the server.
COPY --from=production-dependencies --chown=10001:10001 /app/web/node_modules ./node_modules/
COPY --from=builder --chown=10001:10001 /app/web/package.json /app/web/package-lock.json /app/web/tsconfig.json ./
COPY --from=builder --chown=10001:10001 /app/web/src/server/ ./src/server/
COPY --from=builder --chown=10001:10001 /app/web/scripts/build-governance-fixture.mjs /app/web/scripts/governance-fixture.ts ./scripts/
COPY --from=builder --chown=10001:10001 /app/web/dist/governance-fixture.mjs /app/web/dist/governance-fixture.manifest.json ./dist/
COPY --from=builder --chown=10001:10001 /app/web/dist/verification-container-bridge.mjs ./dist/
COPY --from=builder --chown=10001:10001 /app/worker/ /app/worker/
COPY --from=builder --chown=10001:10001 /app/requirements-workbench.txt /app/requirements-workbench.txt
COPY --chown=10001:10001 contracts/ /app/contracts/
COPY --chown=10001:10001 migrations/ /app/migrations/
COPY --chown=10001:10001 scripts/migrate-workbench.mjs scripts/verification-source.mjs scripts/backup-workbench.mjs scripts/restore-workbench.mjs scripts/archive-legacy.mjs scripts/check-workbench-runtime.mjs /app/scripts/
USER 10001:10001
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD ["node", "/app/scripts/check-workbench-runtime.mjs", "--http"]
CMD ["node", "server.js"]
