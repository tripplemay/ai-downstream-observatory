FROM node:22-bookworm-slim AS dependencies
WORKDIR /app/web
# Bootstrap verified HTTPS from Node's bundled public roots; keep APT signature checks.
RUN node -e "const fs=require('node:fs');fs.writeFileSync('/tmp/apt-ca.pem',require('node:tls').rootCertificates.join(String.fromCharCode(10)));const p='/etc/apt/sources.list.d/debian.sources';fs.writeFileSync(p,fs.readFileSync(p,'utf8').replaceAll('http://deb.debian.org','https://deb.debian.org'))" \
    && apt-get -o Acquire::https::CAInfo=/tmp/apt-ca.pem -o Acquire::https::No-Cache=true update \
    && apt-get -o Acquire::https::CAInfo=/tmp/apt-ca.pem -o Acquire::https::No-Cache=true install -y --no-install-recommends ca-certificates python3 make g++ \
    && rm -rf /var/lib/apt/lists/* /tmp/apt-ca.pem
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund

FROM dependencies AS production-dependencies
RUN npm prune --omit=dev --no-audit --no-fund

FROM dependencies AS builder
COPY web/ /app/web/
COPY contracts/ /app/contracts/
COPY migrations/ /app/migrations/
COPY scripts/ /app/scripts/
COPY worker/accounting/ /app/worker/accounting/
COPY worker/market/ /app/worker/market/
COPY worker/orchestration/ /app/worker/orchestration/
COPY worker/performance/ /app/worker/performance/
COPY worker/research/ /app/worker/research/
COPY worker/governance_verification/ /app/worker/governance_verification/
COPY worker/investor/ /app/worker/investor/
COPY worker/ai_explanation/ /app/worker/ai_explanation/
COPY requirements-workbench.txt /app/requirements-workbench.txt
RUN npm run build:ai-explanation && node scripts/run-ai-explanation.mjs --check

FROM node:22-bookworm-slim AS runner
ARG RELEASE_SHA=development
LABEL org.opencontainers.image.revision=$RELEASE_SHA
WORKDIR /app/web
RUN node -e "const fs=require('node:fs');fs.writeFileSync('/tmp/apt-ca.pem',require('node:tls').rootCertificates.join(String.fromCharCode(10)));const p='/etc/apt/sources.list.d/debian.sources';fs.writeFileSync(p,fs.readFileSync(p,'utf8').replaceAll('http://deb.debian.org','https://deb.debian.org'))" \
    && apt-get -o Acquire::https::CAInfo=/tmp/apt-ca.pem -o Acquire::https::No-Cache=true update \
    && apt-get -o Acquire::https::CAInfo=/tmp/apt-ca.pem -o Acquire::https::No-Cache=true install -y --no-install-recommends python3 python3-venv ca-certificates \
    && rm -rf /var/lib/apt/lists/* /tmp/apt-ca.pem \
    && groupadd --gid 10001 workbench && useradd --uid 10001 --gid workbench --no-create-home workbench
COPY requirements-workbench.txt /app/requirements-workbench.txt
RUN python3 -m venv /opt/workbench-ai && /opt/workbench-ai/bin/pip install --no-cache-dir -r /app/requirements-workbench.txt && /opt/workbench-ai/bin/pip check
COPY --from=production-dependencies /app/web/node_modules ./node_modules/
COPY --from=builder /app/web/src/server/ ./src/server/
COPY --from=builder /app/web/package.json /app/web/package-lock.json /app/web/tsconfig.json ./
COPY --from=builder /app/web/scripts/ai-explanation-worker.ts /app/web/scripts/build-ai-explanation.mjs /app/web/scripts/run-ai-explanation.mjs ./scripts/
COPY --from=builder /app/web/dist/ai-explanation.mjs /app/web/dist/ai-explanation.manifest.json ./dist/
COPY --from=builder /app/scripts/ai-explanation-source.mjs /app/scripts/
COPY --from=builder /app/contracts/ /app/contracts/
COPY --from=builder /app/migrations/ /app/migrations/
COPY --from=builder /app/worker/ /app/worker/
ENV NODE_ENV=production \
    WORKBENCH_DB_PATH=/app/data/etf-workbench.db \
    WORKBENCH_DATA_DIR=/app/data \
    WORKBENCH_AI_PYTHON=/opt/workbench-ai/bin/python \
    WORKBENCH_AI_ENABLE_DISPATCH=0
USER 10001:10001
RUN node scripts/run-ai-explanation.mjs --check
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 CMD ["node", "scripts/run-ai-explanation.mjs", "--health"]
CMD ["node", "scripts/run-ai-explanation.mjs"]
