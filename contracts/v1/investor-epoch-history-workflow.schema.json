{
 "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"investor-epoch-history-workflow.schema.json",
 "$defs":{
  "id":{"type":"string","minLength":1,"maxLength":160},"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"at":{"type":"string","format":"date-time","pattern":"Z$"},"revision":{"type":"integer","minimum":0,"maximum":9007199254740990},
  "prepare_submit":{"type":"object","additionalProperties":false,"required":["schema_version","action","model_id","expected_revision","idempotency_key","acknowledged_plan_only"],"properties":{
   "schema_version":{"const":"investor-epoch-history-workflow-submit-v1"},"action":{"const":"prepare"},"model_id":{"$ref":"#/$defs/id"},"expected_revision":{"$ref":"#/$defs/revision"},"idempotency_key":{"type":"string","minLength":8,"maxLength":160},"acknowledged_plan_only":{"const":true}}},
  "confirm_submit":{"type":"object","additionalProperties":false,"required":["schema_version","action","model_id","expected_revision","idempotency_key","preview_id","expected_preview_hash","max_calls","acknowledgements"],"properties":{
   "schema_version":{"const":"investor-epoch-history-workflow-submit-v1"},"action":{"const":"confirm"},"model_id":{"$ref":"#/$defs/id"},"expected_revision":{"$ref":"#/$defs/revision"},"idempotency_key":{"type":"string","minLength":8,"maxLength":160},
   "preview_id":{"$ref":"#/$defs/id"},"expected_preview_hash":{"$ref":"#/$defs/hash"},"max_calls":{"type":"integer","minimum":1,"maximum":4},"acknowledgements":{"type":"object","additionalProperties":false,"required":["historical_not_live","old_attempts_unchanged","bounded_download_only","no_trading"],"properties":{"historical_not_live":{"const":true},"old_attempts_unchanged":{"const":true},"bounded_download_only":{"const":true},"no_trading":{"const":true}}}}},
  "submit":{"oneOf":[{"$ref":"#/$defs/prepare_submit"},{"$ref":"#/$defs/confirm_submit"}]},
  "request":{"type":"object","additionalProperties":false,"required":["schema_version","request_id","workspace_id","model_id","model_hash","epoch_id","registration_hash","actor_id","body","request_hash","created_at","valid_until","trading_permission"],"properties":{
   "schema_version":{"const":"investor-epoch-history-workflow-request-v1"},"request_id":{"$ref":"#/$defs/id"},"workspace_id":{"$ref":"#/$defs/id"},"model_id":{"$ref":"#/$defs/id"},"model_hash":{"$ref":"#/$defs/hash"},"epoch_id":{"$ref":"#/$defs/id"},"registration_hash":{"$ref":"#/$defs/hash"},"actor_id":{"$ref":"#/$defs/id"},"body":{"$ref":"#/$defs/submit"},"request_hash":{"$ref":"#/$defs/hash"},"created_at":{"$ref":"#/$defs/at"},"valid_until":{"$ref":"#/$defs/at"},"trading_permission":{"const":false}}},
  "result":{"type":"object","additionalProperties":false,"required":["schema_version","result_id","request_id","workspace_id","model_id","epoch_id","actor_id","request_hash","job_id","fencing_token","outcome","code","plan","history_request","source_fence","created_at","valid_until","provider_calls","monitoring_resumed","trading_permission"],"properties":{
   "schema_version":{"const":"investor-epoch-history-workflow-result-v1"},"result_id":{"$ref":"#/$defs/id"},"request_id":{"$ref":"#/$defs/id"},"workspace_id":{"$ref":"#/$defs/id"},"model_id":{"$ref":"#/$defs/id"},"epoch_id":{"$ref":"#/$defs/id"},"actor_id":{"$ref":"#/$defs/id"},"request_hash":{"$ref":"#/$defs/hash"},"job_id":{"$ref":"#/$defs/id"},"fencing_token":{"type":"integer","minimum":1},
   "outcome":{"enum":["plan_ready","download_queued","rejected"]},"code":{"enum":["HISTORY_WORKFLOW_PLAN_READY","HISTORY_WORKFLOW_DOWNLOAD_QUEUED","HISTORY_WORKFLOW_EXPIRED","HISTORY_WORKFLOW_CHANGED","HISTORY_WORKFLOW_SOURCE_UNAVAILABLE","HISTORY_WORKFLOW_REVIEW_REQUIRED"]},
   "plan":{"anyOf":[{"$ref":"investor-epoch-history-plan.schema.json"},{"type":"null"}]},"history_request":{"anyOf":[{"$ref":"investor-epoch-history-plan.schema.json#/$defs/ref"},{"type":"null"}]},"source_fence":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},"created_at":{"$ref":"#/$defs/at"},"valid_until":{"$ref":"#/$defs/at"},"provider_calls":{"const":0},"monitoring_resumed":{"const":false},"trading_permission":{"const":false}}}
 }
}
