{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etf-workbench.invalid/contracts/v1/investor-legacy-transition-job.schema.json",
  "$defs": {
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "request_id", "workspace_id", "model_id", "kind", "body", "request_hash", "created_at", "valid_until"],
      "properties": {
        "schema_version": {"const": "investor-legacy-transition-job-request-v1"},
        "request_id": {"$ref": "common.schema.json#/$defs/id"}, "workspace_id": {"$ref": "common.schema.json#/$defs/id"},
        "model_id": {"$ref": "common.schema.json#/$defs/id"}, "kind": {"enum": ["preview", "confirmation"]},
        "body": {"type": "object"}, "request_hash": {"$ref": "common.schema.json#/$defs/hash"},
        "created_at": {"$ref": "common.schema.json#/$defs/instant"}, "valid_until": {"$ref": "common.schema.json#/$defs/instant"}
      },
      "allOf": [{"if": {"properties": {"kind": {"const": "preview"}}},
        "then": {"properties": {"body": {"$ref": "investor-legacy-transition-workflow.schema.json#/$defs/preview_request"}}},
        "else": {"properties": {"body": {"$ref": "investor-legacy-transition-workflow.schema.json#/$defs/submit"}}}}]
    },
    "code": {"enum": ["LEGACY_TRANSITION_PREVIEW_READY", "LEGACY_TRANSITION_REGISTERED", "LEGACY_TRANSITION_VERSION_CHANGED", "LEGACY_TRANSITION_PREVIEW_EXPIRED", "LEGACY_TRANSITION_REQUEST_EXPIRED", "LEGACY_TRANSITION_ALREADY_CONFIRMED", "LEGACY_TRANSITION_RESTATEMENT_REQUIRED", "LEGACY_TRANSITION_SOURCE_UNAVAILABLE"]},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "result_id", "request_id", "request_hash", "workspace_id", "kind", "job_id", "fencing_token", "outcome", "code", "resource_id", "resource_hash", "created_at", "monitor_source_registered", "current_advice_certified", "monitoring_activated", "trading_permission", "provider_calls"],
      "properties": {
        "schema_version": {"const": "investor-legacy-transition-job-result-v1"}, "result_id": {"$ref": "common.schema.json#/$defs/id"},
        "request_id": {"$ref": "common.schema.json#/$defs/id"}, "request_hash": {"$ref": "common.schema.json#/$defs/hash"},
        "workspace_id": {"$ref": "common.schema.json#/$defs/id"}, "kind": {"enum": ["preview", "confirmation"]},
        "job_id": {"$ref": "common.schema.json#/$defs/id"}, "fencing_token": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "outcome": {"enum": ["preview_ready", "registered", "rejected"]}, "code": {"$ref": "#/$defs/code"},
        "resource_id": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/id"}]},
        "resource_hash": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/hash"}]},
        "created_at": {"$ref": "common.schema.json#/$defs/instant"}, "monitor_source_registered": {"type": "boolean"},
        "current_advice_certified": {"const": false}, "monitoring_activated": {"const": false}, "trading_permission": {"const": false}, "provider_calls": {"const": 0}
      },
      "allOf": [
        {"if": {"properties": {"outcome": {"const": "rejected"}}},
          "then": {"properties": {"resource_id": {"type": "null"}, "resource_hash": {"type": "null"}, "code": {"not": {"enum": ["LEGACY_TRANSITION_PREVIEW_READY", "LEGACY_TRANSITION_REGISTERED"]}}}},
          "else": {"properties": {"resource_id": {"$ref": "common.schema.json#/$defs/id"}, "resource_hash": {"$ref": "common.schema.json#/$defs/hash"}}}},
        {"if": {"properties": {"outcome": {"const": "preview_ready"}}},
          "then": {"properties": {"kind": {"const": "preview"}, "code": {"const": "LEGACY_TRANSITION_PREVIEW_READY"}}}},
        {"if": {"properties": {"outcome": {"const": "registered"}}},
          "then": {"properties": {"kind": {"const": "confirmation"}, "code": {"const": "LEGACY_TRANSITION_REGISTERED"}, "monitor_source_registered": {"const": true}}},
          "else": {"properties": {"monitor_source_registered": {"const": false}}}}
      ]
    }
  }
}
