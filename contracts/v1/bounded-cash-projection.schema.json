{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://etf-workbench.invalid/contracts/v1/bounded-cash-projection.schema.json",
  "oneOf":[{"$ref":"#/$defs/program"},{"$ref":"#/$defs/decisionInput"},{"$ref":"#/$defs/decision"},{"$ref":"#/$defs/valuationInput"},{"$ref":"#/$defs/report"}],
  "$defs":{
    "id":{"$ref":"bounded-cash-buy.schema.json#/$defs/id"},
    "hash":{"$ref":"bounded-cash-buy.schema.json#/$defs/hash"},
    "instant":{"$ref":"bounded-cash-buy.schema.json#/$defs/instant"},
    "cash":{"$ref":"bounded-cash-buy.schema.json#/$defs/cash"},
    "derived":{"$ref":"bounded-cash-buy.schema.json#/$defs/derived"},
    "signed":{"type":"string","maxLength":200,"pattern":"^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "nullableSigned":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/signed"}]},
    "nullableDerived":{"oneOf":[{"type":"null"},{"$ref":"#/$defs/derived"}]},
    "target":{
      "type":"object","additionalProperties":false,"required":["listing_id","weight_bps","quantity_step"],
      "properties":{"listing_id":{"$ref":"#/$defs/id"},"weight_bps":{"type":"integer","minimum":1,"maximum":10000},"quantity_step":{"$ref":"bounded-cash-buy.schema.json#/$defs/number"}}
    },
    "funding":{
      "type":"object","additionalProperties":false,"required":["contribution_id","at","amount_cny"],
      "properties":{"contribution_id":{"$ref":"#/$defs/id"},"at":{"$ref":"#/$defs/instant"},"amount_cny":{"$ref":"#/$defs/cash"}}
    },
    "program":{
      "type":"object","additionalProperties":false,
      "required":["schema_version","engine_version","qualification","journal_declaration_hash","registered_at","targets","cash_target_bps","drift_threshold_bps","funding_schedule","implementation_hash","parameters_independently_preregistered","live_advice_eligible","program_hash"],
      "properties":{
        "schema_version":{"const":"bounded-cash-program-v1"},"engine_version":{"const":"bounded-cash-projection-sandbox-v1"},"qualification":{"const":"synthetic_test_only"},
        "journal_declaration_hash":{"$ref":"#/$defs/hash"},"registered_at":{"$ref":"#/$defs/instant"},
        "targets":{"type":"array","minItems":1,"maxItems":20,"items":{"$ref":"#/$defs/target"}},
        "cash_target_bps":{"type":"integer","minimum":0,"maximum":9999},"drift_threshold_bps":{"type":"integer","minimum":0,"maximum":10000},
        "funding_schedule":{"type":"array","maxItems":120,"items":{"$ref":"#/$defs/funding"}},
        "implementation_hash":{"$ref":"#/$defs/hash"},"parameters_independently_preregistered":{"const":false},"live_advice_eligible":{"const":false},"program_hash":{"$ref":"#/$defs/hash"}
      }
    },
    "mark":{
      "type":"object","additionalProperties":false,"required":["listing_id","quote","corporate_action_unaccounted"],
      "properties":{"listing_id":{"$ref":"#/$defs/id"},"quote":{"$ref":"bounded-cash-buy.schema.json#/$defs/quote"},"corporate_action_unaccounted":{"const":false}}
    },
    "marks":{"type":"array","minItems":1,"maxItems":20,"items":{"$ref":"#/$defs/mark"}},
    "decisionInput":{
      "type":"object","additionalProperties":false,"required":["schema_version","qualification","program","journal","decision_id","at","execute_at","expires_at","marks"],
      "properties":{"schema_version":{"const":"bounded-cash-decision-input-v1"},"qualification":{"const":"synthetic_test_only"},"program":{"$ref":"#/$defs/program"},"journal":{"$ref":"bounded-cash-journal.schema.json#/$defs/journal"},"decision_id":{"$ref":"#/$defs/id"},"at":{"$ref":"#/$defs/instant"},"execute_at":{"$ref":"#/$defs/instant"},"expires_at":{"$ref":"#/$defs/instant"},"marks":{"$ref":"#/$defs/marks"}}
    },
    "allocation":{
      "type":"object","additionalProperties":false,"required":["listing_id","market_value_cny","target_value_cny","underweight_cny","allocated_budget_cny"],
      "properties":{"listing_id":{"$ref":"#/$defs/id"},"market_value_cny":{"$ref":"#/$defs/derived"},"target_value_cny":{"$ref":"#/$defs/derived"},"underweight_cny":{"$ref":"#/$defs/derived"},"allocated_budget_cny":{"$ref":"#/$defs/cash"}}
    },
    "decision":{
      "type":"object","additionalProperties":false,
      "required":["schema_version","qualification","implementation_hash","program_hash","input_hash","state_hash","at","status","nav_cny","cash_floor_cny","deployable_cny","allocations","command","live_advice_eligible","decision_hash"],
      "properties":{
        "schema_version":{"const":"bounded-cash-decision-v1"},"qualification":{"const":"synthetic_test_only"},"implementation_hash":{"$ref":"#/$defs/hash"},"program_hash":{"$ref":"#/$defs/hash"},"input_hash":{"$ref":"#/$defs/hash"},"state_hash":{"$ref":"#/$defs/hash"},"at":{"$ref":"#/$defs/instant"},
        "status":{"enum":["cash_only_underweight_plan","waiting_for_pending_batches","no_deployable_cash","no_eligible_underweight"]},
        "nav_cny":{"$ref":"#/$defs/derived"},"cash_floor_cny":{"$ref":"#/$defs/derived"},"deployable_cny":{"$ref":"#/$defs/cash"},"allocations":{"type":"array","minItems":1,"maxItems":20,"items":{"$ref":"#/$defs/allocation"}},
        "command":{"oneOf":[{"type":"null"},{"$ref":"bounded-cash-journal.schema.json#/$defs/command"}]},"live_advice_eligible":{"const":false},"decision_hash":{"$ref":"#/$defs/hash"}
      }
    },
    "frame":{
      "type":"object","additionalProperties":false,"required":["at","marks"],"properties":{"at":{"$ref":"#/$defs/instant"},"marks":{"$ref":"#/$defs/marks"}}
    },
    "valuationInput":{
      "type":"object","additionalProperties":false,"required":["schema_version","qualification","program","journal","event_frames","final_frame"],
      "properties":{"schema_version":{"const":"bounded-cash-valuation-input-v1"},"qualification":{"const":"synthetic_test_only"},"program":{"$ref":"#/$defs/program"},"journal":{"$ref":"bounded-cash-journal.schema.json#/$defs/journal"},"event_frames":{"type":"array","maxItems":512,"items":{"$ref":"#/$defs/frame"}},"final_frame":{"$ref":"#/$defs/frame"}}
    },
    "sample":{
      "type":"object","additionalProperties":false,
      "required":["revision","at","state_hash","marks_hash","pre_flow_nav_cny","external_flow_cny","nav_cny","settled_cash_cny","reserved_cny","position_value_cny","units","unit_nav","total_return","drawdown"],
      "properties":{
        "revision":{"type":"integer","minimum":0,"maximum":512},"at":{"$ref":"#/$defs/instant"},"state_hash":{"$ref":"#/$defs/hash"},"marks_hash":{"$ref":"#/$defs/hash"},
        "pre_flow_nav_cny":{"$ref":"#/$defs/derived"},"external_flow_cny":{"$ref":"#/$defs/derived"},"nav_cny":{"$ref":"#/$defs/derived"},"settled_cash_cny":{"$ref":"#/$defs/derived"},"reserved_cny":{"$ref":"#/$defs/derived"},"position_value_cny":{"$ref":"#/$defs/derived"},
        "units":{"$ref":"#/$defs/derived"},"unit_nav":{"$ref":"#/$defs/nullableDerived"},"total_return":{"$ref":"#/$defs/nullableSigned"},"drawdown":{"$ref":"#/$defs/nullableDerived"}
      }
    },
    "cashReference":{
      "type":"object","additionalProperties":false,"required":["kind","nav_cny","total_return","difference_cny","investable_market_benchmark"],
      "properties":{"kind":{"const":"same_flow_cash_zero_interest_zero_cost"},"nav_cny":{"$ref":"#/$defs/derived"},"total_return":{"enum":["0",null]},"difference_cny":{"$ref":"#/$defs/signed"},"investable_market_benchmark":{"const":false}}
    },
    "report":{
      "type":"object","additionalProperties":false,
      "required":["schema_version","qualification","implementation_hash","program_hash","input_hash","journal_head_hash","valuation_basis","allocation_policy_compliance_verified","samples","total_contributions_cny","end_nav_cny","net_profit_cny","return_status","cash_flow_adjusted_return","sampled_max_drawdown","cash_reference","execution_failure_count","open_batch_count","live_advice_eligible","report_hash"],
      "properties":{
        "schema_version":{"const":"bounded-cash-valuation-report-v1"},"qualification":{"const":"synthetic_test_only"},"implementation_hash":{"$ref":"#/$defs/hash"},"program_hash":{"$ref":"#/$defs/hash"},"input_hash":{"$ref":"#/$defs/hash"},"journal_head_hash":{"$ref":"#/$defs/hash"},"valuation_basis":{"const":"terminal_processing_not_execution_settlement"},
        "allocation_policy_compliance_verified":{"const":false},
        "samples":{"type":"array","minItems":1,"maxItems":513,"items":{"$ref":"#/$defs/sample"}},"total_contributions_cny":{"$ref":"#/$defs/derived"},"end_nav_cny":{"$ref":"#/$defs/derived"},"net_profit_cny":{"$ref":"#/$defs/signed"},"return_status":{"enum":["calculated","no_contributed_capital"]},"cash_flow_adjusted_return":{"$ref":"#/$defs/nullableSigned"},"sampled_max_drawdown":{"$ref":"#/$defs/nullableDerived"},"cash_reference":{"$ref":"#/$defs/cashReference"},
        "execution_failure_count":{"type":"integer","minimum":0,"maximum":10240},"open_batch_count":{"type":"integer","minimum":0,"maximum":20},"live_advice_eligible":{"const":false},"report_hash":{"$ref":"#/$defs/hash"}
      }
    }
  }
}
