{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etf-workbench.invalid/contracts/v1/investor-experiment.schema.json",
  "$defs": {
    "window": {"type": "object", "required": ["start", "end"], "properties": {
      "start": {"$ref": "common.schema.json#/$defs/instant"}, "end": {"$ref": "common.schema.json#/$defs/instant"}
    }, "additionalProperties": false},
    "budgets": {"type": "object", "required": ["train", "validation", "holdout"], "properties": {
      "train": {"type": "integer", "minimum": 1, "maximum": 8}, "validation": {"const": 1}, "holdout": {"const": 1}
    }, "additionalProperties": false}
  },
  "type": "object",
  "required": ["schema_version", "experiment_id", "workspace_id", "request_id", "input_version", "profile_hash", "dataset_hash", "plan_hash", "policy_hash", "implementation_hash", "candidate_hashes", "benchmark_hash", "trial_budgets", "windows", "source_qualification", "created_at", "live_advice_eligible"],
  "properties": {
    "schema_version": {"const": "investor-experiment-v1"},
    "experiment_id": {"$ref": "common.schema.json#/$defs/id"}, "workspace_id": {"$ref": "common.schema.json#/$defs/id"}, "request_id": {"$ref": "common.schema.json#/$defs/id"},
    "input_version": {"$ref": "common.schema.json#/$defs/hash"}, "profile_hash": {"$ref": "common.schema.json#/$defs/hash"},
    "dataset_hash": {"$ref": "common.schema.json#/$defs/hash"}, "plan_hash": {"$ref": "common.schema.json#/$defs/hash"},
    "policy_hash": {"$ref": "common.schema.json#/$defs/hash"}, "implementation_hash": {"$ref": "common.schema.json#/$defs/hash"},
    "candidate_hashes": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "common.schema.json#/$defs/hash"}},
    "benchmark_hash": {"$ref": "common.schema.json#/$defs/hash"}, "trial_budgets": {"$ref": "#/$defs/budgets"},
    "windows": {"type": "object", "required": ["train", "validation", "holdout"], "properties": {
      "train": {"$ref": "#/$defs/window"}, "validation": {"$ref": "#/$defs/window"}, "holdout": {"$ref": "#/$defs/window"}
    }, "additionalProperties": false},
    "source_qualification": {"enum": ["synthetic_test_only", "owner_reviewed_reconstructed"]}, "created_at": {"$ref": "common.schema.json#/$defs/instant"},
    "live_advice_eligible": {"const": false}
  }, "additionalProperties": false
}
