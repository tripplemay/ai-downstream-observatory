{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etf-workbench.invalid/contracts/v1/collection-schedule.schema.json",
  "title": "Explicit daily ECB collection authorization, not a market publication time or investment approval",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "provider", "feed", "currencies", "frequency", "timezone", "start_date", "end_date", "trigger", "deadline_seconds", "max_attempts", "publish", "missed_policy"],
  "properties": {
    "schema_version": { "const": "collection-schedule-v1" },
    "provider": { "const": "ecb" },
    "feed": { "const": "daily" },
    "currencies": { "type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": { "enum": ["CNY", "HKD", "USD", "EUR", "GBP", "JPY", "CHF", "SGD"] } },
    "frequency": { "const": "daily" },
    "timezone": { "const": "UTC" },
    "start_date": { "$ref": "#/$defs/date" },
    "end_date": { "anyOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }] },
    "trigger": {
      "type": "object", "additionalProperties": false, "required": ["hour", "minute"],
      "properties": { "hour": { "type": "integer", "minimum": 0, "maximum": 23 }, "minute": { "type": "integer", "minimum": 0, "maximum": 59 } }
    },
    "deadline_seconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 5 },
    "publish": { "const": true },
    "missed_policy": { "const": "record_no_backfill" }
  },
  "$defs": { "date": { "type": "string", "format": "date", "pattern": "^(?!0000)[0-9]{4}-[0-9]{2}-[0-9]{2}$" } },
  "description": "The original strict JSON UTF-8 document is limited to 65536 bytes and hashed without reserialization. Runtime enforces end_date >= start_date. UTC dates identify collection slots, never provider rate dates or publication knowledge."
}
