{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etf-workbench.invalid/contracts/v1/market-collect.schema.json",
  "type": "object",
  "required": ["provider", "feed", "currencies", "expected_publication_revision", "publish"],
  "properties": {
    "provider": {"const": "ecb"},
    "feed": {"enum": ["daily", "hist_90d"]},
    "currencies": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["CNY", "HKD", "USD", "EUR", "GBP", "JPY", "CHF", "SGD"]}},
    "expected_publication_revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "publish": {"type": "boolean"}
  },
  "additionalProperties": false
}
