{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etf-workbench.invalid/contracts/v1/research-dataset.schema.json",
  "type": "object",
  "required": ["schema_version", "mode", "source_evidence", "license_scope", "historical_archive_verified", "corporate_actions_complete", "assets", "sessions", "observations", "actions", "publication_refs"],
  "properties": {
    "schema_version": {"enum": ["research-dataset-v1", "research-dataset-v2"]},
    "mode": {"enum": ["synthetic", "reconstructed", "historical_point_in_time", "actual_replay"]},
    "source_evidence": {"type": "string", "minLength": 1, "maxLength": 4000},
    "license_scope": {"type": "string", "minLength": 1, "maxLength": 2000},
    "historical_archive_verified": {"type": "boolean"},
    "corporate_actions_complete": {"type": "boolean"},
    "assets": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"type": "object", "required": ["listing_id", "market", "currency", "quantity_step", "tradable_from", "source_evidence"], "properties": {"listing_id": {"$ref": "common.schema.json#/$defs/id"}, "market": {"enum": ["CN", "HK", "US"]}, "currency": {"$ref": "common.schema.json#/$defs/currency"}, "quantity_step": {"$ref": "common.schema.json#/$defs/decimal"}, "tradable_from": {"$ref": "common.schema.json#/$defs/instant"}, "tradable_until": {"$ref": "common.schema.json#/$defs/instant"}, "source_evidence": {"type": "string", "minLength": 1, "maxLength": 2000}}, "additionalProperties": false}},
    "sessions": {"type": "array", "minItems": 1, "maxItems": 50000, "items": {"type": "object", "required": ["market", "session_date", "close_at", "available_at", "trade_allowed"], "properties": {"market": {"enum": ["CN", "HK", "US"]}, "session_date": {"$ref": "common.schema.json#/$defs/date"}, "close_at": {"$ref": "common.schema.json#/$defs/instant"}, "available_at": {"$ref": "common.schema.json#/$defs/instant"}, "trade_allowed": {"type": "boolean"}}, "additionalProperties": false}},
    "settlements": {"type": "array", "minItems": 1, "maxItems": 50000, "items": {
      "type": "object", "required": ["market", "session_date", "settled_at", "published_at", "source_evidence"],
      "properties": {"market": {"enum": ["CN", "HK", "US"]}, "session_date": {"$ref": "common.schema.json#/$defs/date"}, "settled_at": {"$ref": "common.schema.json#/$defs/instant"}, "published_at": {"$ref": "common.schema.json#/$defs/instant"}, "ingested_at": {"$ref": "common.schema.json#/$defs/instant"}, "source_evidence": {"type": "string", "minLength": 1, "maxLength": 2000}},
      "additionalProperties": false
    }},
    "observations": {"type": "array", "minItems": 1, "maxItems": 250000, "items": {"$ref": "market-observation.schema.json"}},
    "actions": {
      "type": "array", "maxItems": 10000,
      "items": {
        "type": "object", "required": ["id", "listing_id", "type", "at", "published_at", "source_evidence"],
        "properties": {
          "id": {"$ref": "common.schema.json#/$defs/id"}, "listing_id": {"$ref": "common.schema.json#/$defs/id"},
          "type": {"enum": ["split", "dividend"]}, "at": {"$ref": "common.schema.json#/$defs/instant"},
          "published_at": {"$ref": "common.schema.json#/$defs/instant"}, "ingested_at": {"$ref": "common.schema.json#/$defs/instant"},
          "source_evidence": {"type": "string", "minLength": 1}, "ratio": {"$ref": "common.schema.json#/$defs/decimal"},
          "gross_per_unit": {"$ref": "common.schema.json#/$defs/decimal"}, "tax_per_unit": {"$ref": "common.schema.json#/$defs/decimal"},
          "pay_at": {"$ref": "common.schema.json#/$defs/instant"}
        },
        "allOf": [
          {"if": {"properties": {"type": {"const": "split"}}}, "then": {"properties": {"ratio": {"$ref": "common.schema.json#/$defs/decimal"}}, "required": ["ratio"]}, "else": {"properties": {"gross_per_unit": {"$ref": "common.schema.json#/$defs/decimal"}, "tax_per_unit": {"$ref": "common.schema.json#/$defs/decimal"}, "pay_at": {"$ref": "common.schema.json#/$defs/instant"}}, "required": ["gross_per_unit", "tax_per_unit", "pay_at"]}}
        ],
        "additionalProperties": false
      }
    },
    "publication_refs": {"type": "array", "items": {"type": "object", "required": ["scope", "revision", "batch_id", "manifest_hash"], "properties": {"scope": {"$ref": "common.schema.json#/$defs/id"}, "revision": {"type": "integer", "minimum": 1}, "batch_id": {"$ref": "common.schema.json#/$defs/id"}, "manifest_hash": {"$ref": "common.schema.json#/$defs/hash"}}, "additionalProperties": false}}
  },
  "allOf": [
    {"if": {"properties": {"schema_version": {"const": "research-dataset-v2"}}}, "then": {"required": ["settlements"]}, "else": {"not": {"required": ["settlements"]}}},
    {"if": {"properties": {"mode": {"const": "actual_replay"}}}, "then": {"properties": {
      "actions": {"type": "array", "items": {"type": "object", "properties": {"ingested_at": {"$ref": "common.schema.json#/$defs/instant"}}, "required": ["ingested_at"]}},
      "settlements": {"type": "array", "items": {"type": "object", "required": ["ingested_at"]}}
    }}}
  ],
  "additionalProperties": false
}
