{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etf-workbench.invalid/contracts/v1/market-batch.schema.json",
  "type": "object",
  "required": ["schema_version", "batch", "pages"],
  "properties": {
    "schema_version": {"const": "market-batch-v1"},
    "batch": {
      "type": "object",
      "required": ["id", "source_id", "batch_type", "scope", "expected_pages", "expected_rows", "expected_publication_revision", "source_mode"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/id"},
        "source_id": {"$ref": "common.schema.json#/$defs/id"},
        "batch_type": {"enum": ["prices", "fx", "universe", "mixed"]},
        "scope": {"$ref": "common.schema.json#/$defs/id"},
        "expected_pages": {"type": "integer", "minimum": 1, "maximum": 10000},
        "expected_rows": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "expected_publication_revision": {"type": "integer", "minimum": 0},
        "source_mode": {"enum": ["synthetic", "manual_verified"]},
        "source_evidence": {"type": "string", "minLength": 1, "maxLength": 2048}
      },
      "allOf": [
        {"if": {"properties": {"source_mode": {"const": "manual_verified"}}}, "then": {"properties": {"source_evidence": {}}, "required": ["source_evidence"]}}
      ],
      "additionalProperties": false
    },
    "pages": {
      "type": "array", "minItems": 1, "maxItems": 10000,
      "items": {
        "type": "object", "required": ["page_number", "observations"],
        "properties": {
          "page_number": {"type": "integer", "minimum": 1, "maximum": 10000},
          "observations": {"type": "array", "minItems": 1, "maxItems": 1000000, "items": {"$ref": "market-observation.schema.json"}}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
