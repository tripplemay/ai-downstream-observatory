      "properties": {
        "schema_version": {"const": "investor-epoch-continuation-request-v1"}, "request_id": {"$ref": "#/$defs/id"}, "workspace_id": {"$ref": "#/$defs/id"}, "actor_id": {"$ref": "#/$defs/id"}, "model_id": {"$ref": "#/$defs/id"},
        "epoch": {"$ref": "#/$defs/ref"}, "registration_hash": {"$ref": "#/$defs/hash"}, "activation": {"$ref": "#/$defs/ref"},
        "previous_input": {"$ref": "#/$defs/ref"}, "previous_checkpoint": {"$ref": "#/$defs/ref"}, "workspace_revision": {"type": "integer", "minimum": 1}, "context_key": {"$ref": "#/$defs/hash"}, "request_key": {"$ref": "#/$defs/hash"},
        "input": {"$ref": "investor-model-epoch-source.schema.json#/$defs/input"}, "source_proof": {"$ref": "investor-model-epoch-continuation-source.schema.json#/$defs/proof"},
        "source_ceiling": {"$ref": "#/$defs/instant"}, "implementation_hash": {"$ref": "#/$defs/hash"}, "monitor_request": {"$ref": "#/$defs/monitor_request"},
