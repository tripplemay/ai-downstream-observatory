        "model_hash": {"$ref": "#/$defs/hash"}, "profile_hash": {"$ref": "#/$defs/hash"}, "control_id": {"$ref": "#/$defs/id"}, "input_hash": {"$ref": "#/$defs/hash"}, "checkpoint_hash": {"$ref": "#/$defs/hash"}
      }},
    "request": {"type": "object", "additionalProperties": false,
