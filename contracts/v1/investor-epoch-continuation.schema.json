      "properties": {
        "schema_version": {"const": "investor-epoch-control-v1"}, "control_id": {"$ref": "#/$defs/id"}, "workspace_id": {"$ref": "#/$defs/id"}, "actor_id": {"$ref": "#/$defs/id"}, "model_id": {"$ref": "#/$defs/id"},
        "epoch": {"$ref": "#/$defs/ref"}, "registration_hash": {"$ref": "#/$defs/hash"}, "version": {"type": "integer", "minimum": 1, "maximum": 1000},
        "workspace_revision": {"type": "integer", "minimum": 1}, "body": {"$ref": "#/$defs/control_submit"}, "created_at": {"$ref": "#/$defs/instant"}, "valid_until": {"$ref": "#/$defs/instant"}, "trading_permission": {"const": false}
      }},
