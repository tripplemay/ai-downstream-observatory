{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etf-workbench.invalid/contracts/v1/investor-epoch-continuation.schema.json",
  "$defs": {
    "id": {"$ref": "common.schema.json#/$defs/id"}, "hash": {"$ref": "common.schema.json#/$defs/hash"},
    "instant": {"$ref": "investor-planned-funding-monitor.schema.json#/$defs/instant"},
    "ref": {"$ref": "investor-model-epoch-source.schema.json#/$defs/reference"},
    "control_submit": {"type": "object", "additionalProperties": false,
      "required": ["schema_version", "epoch_id", "expected_registration_hash", "expected_checkpoint", "expected_revision", "idempotency_key", "enabled", "acknowledgements"],
      "properties": {
        "schema_version": {"const": "investor-epoch-control-submit-v1"}, "epoch_id": {"$ref": "#/$defs/id"}, "expected_registration_hash": {"$ref": "#/$defs/hash"},
        "expected_checkpoint": {"$ref": "#/$defs/ref"}, "expected_revision": {"type": "integer", "minimum": 1},
        "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 128}, "enabled": {"type": "boolean"},
        "acknowledgements": {"type": "object", "additionalProperties": false,
          "required": ["current_epoch_seen", "continuous_research_only", "preserve_history_and_human_trading"],
          "properties": {"current_epoch_seen": {"const": true}, "continuous_research_only": {"const": true}, "preserve_history_and_human_trading": {"const": true}}}
      }},
    "control": {"type": "object", "additionalProperties": false,
