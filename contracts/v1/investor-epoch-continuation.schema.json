    "publication": {"type": "object", "additionalProperties": false,
      "required": ["schema_version", "publication_id", "workspace_id", "actor_id", "model_id", "epoch", "sequence", "request", "activation", "previous_input", "previous_checkpoint", "previous_publication", "input", "checkpoint", "checkpoint_reused", "monitor_run_id", "observation_id", "job_id", "implementation_hash", "source_proof", "source_ceiling", "workspace_revision", "calculated_at", "created_at", "publication_deadline", "valid_until", "monitoring_resumed", "historical_observations_rewritten", "provider_calls", "trading_permission", "distribution"],
      "properties": {
        "schema_version": {"const": "investor-epoch-continuation-publication-v1"}, "publication_id": {"$ref": "#/$defs/id"}, "workspace_id": {"$ref": "#/$defs/id"}, "actor_id": {"$ref": "#/$defs/id"}, "model_id": {"$ref": "#/$defs/id"},
        "epoch": {"$ref": "#/$defs/ref"}, "sequence": {"type": "integer", "minimum": 1, "maximum": 1000}, "request": {"$ref": "#/$defs/ref"}, "activation": {"$ref": "#/$defs/ref"},
        "previous_input": {"$ref": "#/$defs/ref"}, "previous_checkpoint": {"$ref": "#/$defs/ref"}, "previous_publication": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/ref"}]},
        "input": {"$ref": "#/$defs/ref"}, "checkpoint": {"$ref": "#/$defs/ref"}, "checkpoint_reused": {"type": "boolean"}, "monitor_run_id": {"$ref": "#/$defs/id"}, "observation_id": {"$ref": "#/$defs/id"}, "job_id": {"$ref": "#/$defs/id"},
        "implementation_hash": {"$ref": "#/$defs/hash"}, "source_proof": {"$ref": "investor-model-epoch-continuation-source.schema.json#/$defs/proof"}, "source_ceiling": {"$ref": "#/$defs/instant"}, "workspace_revision": {"type": "integer", "minimum": 1},
        "calculated_at": {"$ref": "#/$defs/instant"}, "created_at": {"$ref": "#/$defs/instant"}, "publication_deadline": {"$ref": "#/$defs/instant"}, "valid_until": {"$ref": "#/$defs/instant"},
        "monitoring_resumed": {"const": true}, "historical_observations_rewritten": {"const": false}, "provider_calls": {"const": 0}, "trading_permission": {"const": false}, "distribution": {"const": "private_owner_only_not_ai"}
