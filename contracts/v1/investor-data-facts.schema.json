{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etf-workbench.invalid/contracts/v1/investor-data-facts.schema.json",
  "$defs": {
    "rights": {"type": "object", "required": ["provider", "account_region", "markets", "uses", "retention_days", "valid_from", "valid_until", "clause_references"], "properties": {
      "provider": {"const": "longport"}, "account_region": {"enum": ["HK", "SG"]},
      "markets": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["CN", "HK", "US"]}},
      "uses": {"type": "array", "minItems": 1, "maxItems": 5, "uniqueItems": true, "items": {"enum": ["private_research", "private_retention", "private_display", "private_backup", "external_ai"]}},
      "retention_days": {"type": "integer", "minimum": 1, "maximum": 36600}, "valid_from": {"$ref": "common.schema.json#/$defs/instant"}, "valid_until": {"$ref": "common.schema.json#/$defs/instant"},
      "clause_references": {"type": "array", "minItems": 1, "maxItems": 20, "items": {"type": "string", "minLength": 1, "maxLength": 300}}
    }, "additionalProperties": false},
    "listing": {"type": "object", "required": ["listing_id", "provider_symbol", "market", "currency", "quantity_step", "tradable_from", "tradable_until", "product_type", "leveraged", "inverse", "role", "fee_rate", "fee_as_of", "economic_exposure", "historical_universe_basis"], "properties": {
      "listing_id": {"$ref": "common.schema.json#/$defs/id"}, "provider_symbol": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.(SH|SZ|HK|US)$", "maxLength": 80},
      "market": {"enum": ["CN", "HK", "US"]}, "currency": {"enum": ["CNY", "HKD", "USD"]}, "quantity_step": {"$ref": "common.schema.json#/$defs/decimal"},
      "tradable_from": {"$ref": "common.schema.json#/$defs/instant"}, "tradable_until": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/instant"}]},
      "product_type": {"const": "ETF"}, "leveraged": {"const": false}, "inverse": {"const": false}, "role": {"enum": ["growth", "defensive", "diversifier"]},
      "fee_rate": {"$ref": "common.schema.json#/$defs/decimal"}, "fee_as_of": {"$ref": "common.schema.json#/$defs/date"},
      "economic_exposure": {"type": "string", "minLength": 1, "maxLength": 1000}, "historical_universe_basis": {"const": "retrospectively_selected_not_survivorship_free"}
    }, "additionalProperties": false},
    "calendar": {"type": "object", "required": ["market", "range_start", "range_end", "days"], "properties": {
      "market": {"enum": ["CN", "HK", "US"]}, "range_start": {"$ref": "common.schema.json#/$defs/date"}, "range_end": {"$ref": "common.schema.json#/$defs/date"},
      "days": {"type": "array", "minItems": 1, "maxItems": 3660, "items": {"type": "object", "required": ["date", "kind", "close_at", "available_at", "settled_at", "settlement_rule_known_at"], "properties": {
        "date": {"$ref": "common.schema.json#/$defs/date"}, "kind": {"enum": ["closed", "full", "half"]},
        "close_at": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/instant"}]}, "available_at": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/instant"}]},
        "settled_at": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/instant"}]}, "settlement_rule_known_at": {"oneOf": [{"type": "null"}, {"$ref": "common.schema.json#/$defs/instant"}]}
      }, "additionalProperties": false}}
    }, "additionalProperties": false},
    "actions": {"type": "object", "required": ["listing_id", "range_start", "range_end", "coverage", "tax_assumption", "events"], "properties": {
      "listing_id": {"$ref": "common.schema.json#/$defs/id"}, "range_start": {"$ref": "common.schema.json#/$defs/date"}, "range_end": {"$ref": "common.schema.json#/$defs/date"},
      "coverage": {"const": "reviewed_complete"}, "tax_assumption": {"type": "string", "minLength": 1, "maxLength": 1000},
      "events": {"$ref": "research-dataset.schema.json#/properties/actions"}
    }, "additionalProperties": false},
    "fx": {"type": "object", "required": ["currency", "unit", "rows"], "properties": {
      "currency": {"enum": ["HKD", "USD"]}, "unit": {"const": "CNY_per_unit_currency"},
      "monitor_series": {"type": "object", "required": ["authority_id", "revision_policy"], "properties": {
        "authority_id": {"$ref": "common.schema.json#/$defs/id"},
        "revision_policy": {"const": "append_only_no_restatements"}
      }, "additionalProperties": false},
      "rows": {"type": "array", "minItems": 1, "maxItems": 20000, "items": {"type": "object", "required": ["observed_at", "assumed_available_at", "value"], "properties": {
        "observed_at": {"$ref": "common.schema.json#/$defs/instant"}, "assumed_available_at": {"$ref": "common.schema.json#/$defs/instant"}, "value": {"$ref": "common.schema.json#/$defs/decimal"}
      }, "additionalProperties": false}}
    }, "additionalProperties": false}
  },
  "oneOf": [
    {"type": "object", "required": ["kind", "facts"], "properties": {"kind": {"const": "rights"}, "facts": {"$ref": "#/$defs/rights"}}, "additionalProperties": false},
    {"type": "object", "required": ["kind", "facts"], "properties": {"kind": {"const": "listing"}, "facts": {"$ref": "#/$defs/listing"}}, "additionalProperties": false},
    {"type": "object", "required": ["kind", "facts"], "properties": {"kind": {"const": "calendar"}, "facts": {"$ref": "#/$defs/calendar"}}, "additionalProperties": false},
    {"type": "object", "required": ["kind", "facts"], "properties": {"kind": {"const": "actions"}, "facts": {"$ref": "#/$defs/actions"}}, "additionalProperties": false},
    {"type": "object", "required": ["kind", "facts"], "properties": {"kind": {"const": "fx"}, "facts": {"$ref": "#/$defs/fx"}}, "additionalProperties": false}
  ]
}
