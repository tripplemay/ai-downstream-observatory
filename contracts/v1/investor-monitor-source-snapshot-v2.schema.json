{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etf-workbench.invalid/contracts/v1/investor-monitor-source-snapshot-v2.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "created_at", "range_start", "range_end", "mode", "capture_refs", "review_refs", "action_availability_refs", "publication_times", "universe_basis", "review_basis", "external_ai_authorized", "live_advice_eligible", "use_scope"],
  "properties": {
    "schema_version": {"const": "investor-monitor-source-snapshot-v2"},
    "workspace_id": {"$ref": "common.schema.json#/$defs/id"}, "created_at": {"$ref": "investor-reference-plan.schema.json#/$defs/instant"},
    "range_start": {"$ref": "common.schema.json#/$defs/date"}, "range_end": {"$ref": "common.schema.json#/$defs/date"}, "mode": {"const": "reconstructed"},
    "capture_refs": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "investor-monitor-price-snapshot.schema.json#/properties/capture_refs/items"}},
    "review_refs": {"$ref": "investor-monitor-price-snapshot.schema.json#/properties/review_refs"},
    "action_availability_refs": {"type": "array", "maxItems": 10000, "uniqueItems": true, "items": {"$ref": "#/$defs/action_availability"}},
    "publication_times": {"const": "reconstructed_prices_and_audited_action_review_times_not_point_in_time"},
    "universe_basis": {"const": "retrospectively_selected_not_survivorship_free"}, "review_basis": {"const": "owner_reviewed_not_provider_certified"},
    "external_ai_authorized": {"const": false}, "live_advice_eligible": {"const": false}, "use_scope": {"const": "monitor_only"}
  },
  "$defs": {
    "action_availability": {
      "type": "object", "additionalProperties": false,
      "required": ["review_id", "review_hash", "event_id", "event_hash", "original_review_id", "original_review_hash", "known_at"],
      "properties": {
        "review_id": {"$ref": "common.schema.json#/$defs/id"}, "review_hash": {"$ref": "common.schema.json#/$defs/hash"},
        "event_id": {"$ref": "common.schema.json#/$defs/id"}, "event_hash": {"$ref": "common.schema.json#/$defs/hash"},
        "original_review_id": {"$ref": "common.schema.json#/$defs/id"}, "original_review_hash": {"$ref": "common.schema.json#/$defs/hash"},
        "known_at": {"type": "string", "format": "date-time", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?Z$"}
      }
    }
  }
}
