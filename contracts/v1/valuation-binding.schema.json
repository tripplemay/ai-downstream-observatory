{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etf-workbench.local/contracts/v1/valuation-binding.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["ledger_revision", "market_heads"],
  "properties": {
    "ledger_revision": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
    "market_heads": {
      "type": "object", "maxProperties": 4,
      "propertyNames": { "type": "string", "minLength": 1, "maxLength": 200 },
      "additionalProperties": {
        "type": "object", "additionalProperties": false,
        "required": ["revision", "manifest_hash"],
        "properties": {
          "revision": { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
          "manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
