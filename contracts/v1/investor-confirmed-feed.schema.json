{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "investor-confirmed-feed.schema.json",
  "$ref": "#/$defs/request",
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 160},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["rights_review_id", "listing_review_id", "calendar_review_id", "session_date"],
      "properties": {
        "rights_review_id": {"$ref": "#/$defs/id"}, "listing_review_id": {"$ref": "#/$defs/id"},
        "calendar_review_id": {"$ref": "#/$defs/id"}, "session_date": {"type": "string", "format": "date"}
      }
    },
    "request": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "engine_version", "workspace_id", "model_id", "model_hash", "control_id", "input_id", "input_hash", "market", "session_date", "targets", "binding_hash", "not_before", "latest_start", "stop_at", "valid_until", "live_advice_eligible"],
      "properties": {
        "schema_version": {"const": "investor-confirmed-feed-request-v1"}, "engine_version": {"const": "investor-confirmed-market-producer-v1"},
        "workspace_id": {"$ref": "#/$defs/id"}, "model_id": {"$ref": "#/$defs/id"}, "model_hash": {"$ref": "#/$defs/hash"},
        "control_id": {"$ref": "#/$defs/id"}, "input_id": {"$ref": "#/$defs/id"}, "input_hash": {"$ref": "#/$defs/hash"},
        "market": {"enum": ["CN", "HK", "US"]}, "session_date": {"type": "string", "format": "date"},
        "targets": {"type": "array", "minItems": 1, "maxItems": 20, "uniqueItems": true, "items": {"$ref": "#/$defs/target"}},
        "binding_hash": {"$ref": "#/$defs/hash"}, "not_before": {"$ref": "#/$defs/at"}, "latest_start": {"$ref": "#/$defs/at"},
        "stop_at": {"$ref": "#/$defs/at"}, "valid_until": {"$ref": "#/$defs/at"}, "live_advice_eligible": {"const": false}
      }
    },
    "run": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "request_id", "request_hash", "job_id", "capture_id", "receipt_hash", "status", "reason_code", "created_at", "live_advice_eligible"],
      "properties": {
        "schema_version": {"const": "investor-confirmed-feed-run-v1"}, "request_id": {"$ref": "#/$defs/id"}, "request_hash": {"$ref": "#/$defs/hash"}, "job_id": {"$ref": "#/$defs/id"},
        "capture_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "receipt_hash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "status": {"enum": ["complete", "partial", "no_confirmed_events", "missed_window", "superseded", "transport_failed"]},
        "reason_code": {"enum": ["CONFIRMED_FEED_COMPLETE", "CONFIRMED_FEED_PARTIAL", "CONFIRMED_FEED_NO_EVENTS", "CONFIRMED_FEED_MISSED_WINDOW", "CONFIRMED_FEED_SUPERSEDED", "CONFIRMED_FEED_TRANSPORT_FAILED"]},
        "created_at": {"$ref": "#/$defs/at"}, "live_advice_eligible": {"const": false}
      }
    },
    "refresh": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "model_id", "model_hash", "control_id", "previous_input_id", "previous_input_hash", "input_id", "input_hash", "created_at", "live_advice_eligible"],
      "properties": {
        "schema_version": {"const": "investor-monitor-source-refresh-v1"},
        "model_id": {"$ref": "#/$defs/id"}, "model_hash": {"$ref": "#/$defs/hash"}, "control_id": {"$ref": "#/$defs/id"},
        "previous_input_id": {"$ref": "#/$defs/id"}, "previous_input_hash": {"$ref": "#/$defs/hash"},
        "input_id": {"$ref": "#/$defs/id"}, "input_hash": {"$ref": "#/$defs/hash"},
        "created_at": {"$ref": "#/$defs/at"}, "live_advice_eligible": {"const": false}
      }
    },
    "admission": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "run_id", "run_hash", "input_id", "input_hash", "status", "reason_code", "created_at", "live_advice_eligible"],
      "properties": {
        "schema_version": {"const": "investor-confirmed-feed-admission-v1"}, "run_id": {"$ref": "#/$defs/id"}, "run_hash": {"$ref": "#/$defs/hash"},
        "input_id": {"anyOf": [{"$ref": "#/$defs/id"}, {"type": "null"}]}, "input_hash": {"anyOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "status": {"enum": ["admitted", "blocked", "superseded"]}, "reason_code": {"enum": ["CONFIRMED_FEED_ADMITTED", "CONFIRMED_FEED_INPUT_GAP", "CONFIRMED_FEED_SUPERSEDED"]},
        "created_at": {"$ref": "#/$defs/at"}, "live_advice_eligible": {"const": false}
      }
    }
  }
}
