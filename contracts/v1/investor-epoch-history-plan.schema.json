{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"investor-epoch-history-plan.schema.json",
  "type":"object","additionalProperties":false,
  "required":["schema_version","engine_version","workspace_id","actor_id","model_id","model_hash","epoch","registration_hash","activation","model_control","input","checkpoint","workspace_revision","source_fence","implementation_hash","planned_at","valid_until","ranges","tiles","expected_date_count","retained_date_count","missing_date_count","status","prior_attempts","max_batch_calls","max_window_days","provider_calls","database_writes","future_calls_authorized","current_source_eligibility_restored","monitoring_resumed","trading_permission","market_values_output","distribution","plan_hash","checked_at"],
  "properties":{
    "schema_version":{"const":"investor-epoch-history-plan-v1"},"engine_version":{"const":"investor-epoch-history-planner-v1"},
    "workspace_id":{"$ref":"#/$defs/id"},"actor_id":{"$ref":"#/$defs/id"},"model_id":{"$ref":"#/$defs/id"},"model_hash":{"$ref":"#/$defs/hash"},
    "epoch":{"$ref":"#/$defs/ref"},"registration_hash":{"$ref":"#/$defs/hash"},"activation":{"$ref":"#/$defs/ref"},"model_control":{"$ref":"#/$defs/ref"},"input":{"$ref":"#/$defs/ref"},"checkpoint":{"$ref":"#/$defs/ref"},
    "workspace_revision":{"type":"integer","minimum":0,"maximum":9007199254740991},"source_fence":{"$ref":"#/$defs/hash"},"implementation_hash":{"$ref":"#/$defs/hash"},
    "planned_at":{"$ref":"#/$defs/at"},"checked_at":{"$ref":"#/$defs/at"},"valid_until":{"$ref":"#/$defs/at"},"plan_hash":{"$ref":"#/$defs/hash"},
    "ranges":{"type":"array","minItems":1,"maxItems":3,"items":{"type":"object","additionalProperties":false,"required":["market","checkpoint_date","past_end_date","current_local_date"],"properties":{
      "market":{"$ref":"#/$defs/market"},"checkpoint_date":{"$ref":"#/$defs/day"},"past_end_date":{"$ref":"#/$defs/day"},"current_local_date":{"$ref":"#/$defs/day"}}}},
    "tiles":{"type":"array","maxItems":128,"items":{"type":"object","additionalProperties":false,
      "required":["listing_id","symbol","market","currency","start_date","end_date","expected_dates","rights_review_id","listing_review_id","calendar_review_id","binding_hash"],
      "properties":{"listing_id":{"$ref":"#/$defs/id"},"symbol":{"type":"string","minLength":1,"maxLength":64},"market":{"$ref":"#/$defs/market"},"currency":{"enum":["CNY","HKD","USD"]},
        "start_date":{"$ref":"#/$defs/day"},"end_date":{"$ref":"#/$defs/day"},"expected_dates":{"type":"array","minItems":1,"maxItems":31,"uniqueItems":true,"items":{"$ref":"#/$defs/day"}},
        "rights_review_id":{"$ref":"#/$defs/id"},"listing_review_id":{"$ref":"#/$defs/id"},"calendar_review_id":{"$ref":"#/$defs/id"},"binding_hash":{"$ref":"#/$defs/hash"}}}},
    "expected_date_count":{"$ref":"#/$defs/count"},"retained_date_count":{"$ref":"#/$defs/count"},"missing_date_count":{"$ref":"#/$defs/count"},
    "status":{"enum":["download_confirmation_required","no_missing_past_closes","overlap_review_required"]},
    "prior_attempts":{"type":"array","maxItems":1000,"items":{"type":"object","additionalProperties":false,
      "required":["kind","request","market","session_date","job_id","job_status","attempt_count","network_outcome_inferred"],
      "properties":{"kind":{"enum":["epoch_callback","legacy_callback","initial_callback"]},"request":{"$ref":"#/$defs/ref"},"market":{"$ref":"#/$defs/market"},"session_date":{"$ref":"#/$defs/day"},
        "job_id":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"job_status":{"enum":[null,"queued","retry_queued","running","succeeded","failed","partial","skipped","cancelled"]},"attempt_count":{"type":"integer","minimum":0,"maximum":1},"network_outcome_inferred":{"const":false}}}},
    "max_batch_calls":{"const":4},"max_window_days":{"const":31},"provider_calls":{"const":0},"database_writes":{"const":0},"future_calls_authorized":{"const":false},
    "current_source_eligibility_restored":{"const":false},"monitoring_resumed":{"const":false},"trading_permission":{"const":false},"market_values_output":{"const":false},"distribution":{"const":"private_owner_only_not_ai"}
  },
  "$defs":{
    "id":{"type":"string","minLength":1,"maxLength":160},"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"at":{"type":"string","format":"date-time","pattern":"Z$"},
    "ref":{"type":"object","additionalProperties":false,"required":["id","content_hash"],"properties":{"id":{"$ref":"#/$defs/id"},"content_hash":{"$ref":"#/$defs/hash"}}},
    "day":{"type":"string","format":"date"},"market":{"enum":["CN","HK","US"]},"count":{"type":"integer","minimum":0,"maximum":73200}
  }
}
