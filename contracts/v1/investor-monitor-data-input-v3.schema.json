{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etf-workbench.invalid/contracts/v1/investor-monitor-data-input-v3.schema.json",
  "type": "object", "required": ["schema_version", "workspace_id", "model_id", "target_definition_hash", "source_qualification", "segments", "settings", "projection_hash", "created_at", "valid_until", "live_advice_eligible"],
  "properties": {
    "schema_version": {"const": "investor-monitor-data-input-v3"}, "workspace_id": {"$ref": "common.schema.json#/$defs/id"}, "model_id": {"$ref": "common.schema.json#/$defs/id"},
    "target_definition_hash": {"$ref": "common.schema.json#/$defs/hash"}, "source_qualification": {"const": "owner_reviewed_reconstructed"},
    "segments": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"$ref": "investor-monitor-data-input-v2.schema.json#/properties/segments/items"}},
    "settings": {"$ref": "#/$defs/settings"}, "projection_hash": {"$ref": "common.schema.json#/$defs/hash"},
    "created_at": {"$ref": "investor-reference-plan.schema.json#/$defs/instant"}, "valid_until": {"$ref": "investor-reference-plan.schema.json#/$defs/instant"}, "live_advice_eligible": {"const": false}
  }, "additionalProperties": false,
  "$defs": {"settings": {"type": "object", "required": ["policy", "funding_intent", "max_quote_age_seconds", "cost_assumptions"],
    "properties": {
      "policy": {"$ref": "investor-model-monitor.schema.json#/properties/policy"}, "funding_intent": {"$ref": "investor-model-monitor.schema.json#/properties/funding_intent"},
      "max_quote_age_seconds": {"$ref": "investor-monitor-data-input.schema.json#/$defs/settings/properties/max_quote_age_seconds"},
      "cost_assumptions": {"$ref": "investor-monitor-costs.schema.json#/$defs/binding"}
    }, "additionalProperties": false}}
}
