{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etf-workbench.invalid/contracts/v1/investor-unchanged-action-recovery.schema.json",
  "$defs": {
    "submit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "preview_id",
        "expected_revision",
        "idempotency_key",
        "failed_publication_id",
        "failed_publication_hash",
        "acknowledgements",
        "enable_rule"
      ],
      "properties": {
        "schema_version": {
          "const": "investor-unchanged-action-recovery-submit-v1"
        },
        "preview_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "expected_revision": {
          "$ref": "investor-action-review-workflow.schema.json#/$defs/revision"
        },
        "idempotency_key": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "failed_publication_id": { "$ref": "common.schema.json#/$defs/id" },
        "failed_publication_hash": { "$ref": "common.schema.json#/$defs/hash" },
        "acknowledgements": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "unchanged_economic_events_and_tax",
            "source_overlap_and_old_differences_unchanged",
            "reported_coverage_not_objective_absence",
            "original_failure_and_history_retained",
            "separate_current_data_readmission",
            "register_new_default_off_rule"
          ],
          "properties": {
            "unchanged_economic_events_and_tax": {
              "const": true
            },
            "source_overlap_and_old_differences_unchanged": {
              "const": true
            },
            "reported_coverage_not_objective_absence": {
              "const": true
            },
            "original_failure_and_history_retained": {
              "const": true
            },
            "separate_current_data_readmission": {
              "const": true
            },
            "register_new_default_off_rule": {
              "const": true
            }
          }
        },
        "enable_rule": {
          "type": "boolean"
        }
      }
    },
    "proof": {
      "type": "object",
      "required": [
        "status",
        "previous_facts_hash",
        "reviewed_facts_hash",
        "previous_snapshot_hash",
        "current_snapshot_hash",
        "previous_coverage_end",
        "new_coverage_end",
        "added_event_count",
        "added_dividend_count",
        "added_split_count",
        "new_nominal_difference_count",
        "knowledge_basis",
        "late_knowledge_event_count",
        "continuation_timing_ready",
        "requires_separate_knowledge_or_start",
        "old_events_and_tax_assumption_unchanged",
        "owner_approval_verified",
        "source_authority_verified",
        "handover_registered",
        "research_admitted",
        "trading_permission",
        "provider_calls",
        "database_writes",
        "raw_amounts_or_tax_text_output",
        "failed_publication_id",
        "failed_publication_hash",
        "failed_source_day",
        "failed_at",
        "failure_code"
      ],
      "properties": {
        "status": {
          "const": "unchanged_recovery_prepared_only"
        },
        "previous_facts_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "reviewed_facts_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "previous_snapshot_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "current_snapshot_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "previous_coverage_end": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "new_coverage_end": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "added_event_count": {
          "const": 0
        },
        "added_dividend_count": {
          "const": 0
        },
        "added_split_count": {
          "const": 0
        },
        "new_nominal_difference_count": {
          "const": 0
        },
        "knowledge_basis": {
          "const": "current_complete_report_receipts_only"
        },
        "late_knowledge_event_count": {
          "const": 0
        },
        "continuation_timing_ready": {
          "type": "boolean"
        },
        "requires_separate_knowledge_or_start": {
          "type": "boolean"
        },
        "old_events_and_tax_assumption_unchanged": {
          "const": true
        },
        "owner_approval_verified": {
          "const": false
        },
        "source_authority_verified": {
          "const": false
        },
        "handover_registered": {
          "const": false
        },
        "research_admitted": {
          "const": false
        },
        "trading_permission": {
          "const": false
        },
        "provider_calls": {
          "const": 0
        },
        "database_writes": {
          "const": 0
        },
        "raw_amounts_or_tax_text_output": {
          "const": false
        },
        "failed_publication_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "failed_publication_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "failed_source_day": {
          "$ref": "common.schema.json#/$defs/date"
        },
        "failed_at": {
          "$ref": "common.schema.json#/$defs/instant"
        },
        "failure_code": {
          "enum": ["SOURCE_CAPTURE_TERMINAL_FAILURE", "MAINTENANCE_WINDOW_MISSED"]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "late_knowledge_event_count": {
                "const": 0
              }
            }
          },
          "then": {
            "properties": {
              "continuation_timing_ready": {
                "const": true
              },
              "requires_separate_knowledge_or_start": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "continuation_timing_ready": {
                "const": false
              },
              "requires_separate_knowledge_or_start": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "confirmation_id",
        "workspace_id",
        "workspace_revision",
        "preview_id",
        "request",
        "request_hash",
        "draft_basis_hash",
        "previous_authority_id",
        "previous_authority_hash",
        "previous_control_id",
        "previous_control_hash",
        "retired_control_id",
        "retired_control_hash",
        "previous_publication_id",
        "previous_review_id",
        "previous_review_hash",
        "new_review_id",
        "new_review_hash",
        "new_authority_id",
        "new_authority_hash",
        "new_control_id",
        "new_control_hash",
        "append_proof",
        "created_at",
        "monitor_data_readmission_required",
        "quarantine_cleared",
        "research_admitted",
        "trading_permission",
        "raw_ai_sharing",
        "provider_calls"
      ],
      "properties": {
        "schema_version": {
          "const": "investor-unchanged-action-recovery-confirmation-v1"
        },
        "confirmation_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "workspace_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "workspace_revision": {
          "$ref": "investor-action-review-workflow.schema.json#/$defs/revision"
        },
        "preview_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "request": {
          "$ref": "#/$defs/submit"
        },
        "request_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "draft_basis_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "previous_authority_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "previous_authority_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "previous_control_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "previous_control_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "retired_control_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "retired_control_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "previous_publication_id": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "common.schema.json#/$defs/id"
            }
          ]
        },
        "previous_review_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "previous_review_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "new_review_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "new_review_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "new_authority_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "new_authority_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "new_control_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "new_control_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "append_proof": {
          "$ref": "#/$defs/proof"
        },
        "created_at": {
          "$ref": "investor-action-review-workflow.schema.json#/$defs/instant"
        },
        "monitor_data_readmission_required": {
          "const": true
        },
        "quarantine_cleared": {
          "const": false
        },
        "research_admitted": {
          "const": false
        },
        "trading_permission": {
          "const": false
        },
        "raw_ai_sharing": {
          "const": false
        },
        "provider_calls": {
          "const": 0
        }
      }
    },
    "successor_preview": {
      "type": "object",
      "required": [
        "status",
        "checked_at",
        "refresh_after",
        "previous_authority_id",
        "previous_authority_hash",
        "previous_control_id",
        "previous_control_hash",
        "previous_control_enabled",
        "previous_publication_id",
        "next_authority_id",
        "next_authority_hash",
        "next_control_id",
        "next_control_hash",
        "previous_manual_review_id",
        "next_manual_review_id",
        "next_manual_review_record_verified",
        "approval_performed_by_preview",
        "append_proof",
        "source_control_and_raw_bindings_verified",
        "continuation_timing_ready",
        "requires_separate_knowledge_or_start",
        "handover_registered",
        "next_rule_enabled",
        "quarantine_cleared",
        "provider_calls",
        "database_writes",
        "research_admitted",
        "trading_permission",
        "raw_amounts_or_tax_text_output"
      ],
      "properties": {
        "status": {
          "const": "explicit_unchanged_recovery_prepared_not_registered"
        },
        "checked_at": {
          "$ref": "common.schema.json#/$defs/instant"
        },
        "refresh_after": {
          "$ref": "common.schema.json#/$defs/instant"
        },
        "previous_authority_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "previous_authority_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "previous_control_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "previous_control_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "previous_control_enabled": {
          "type": "boolean"
        },
        "previous_publication_id": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/id"
            },
            {
              "type": "null"
            }
          ]
        },
        "next_authority_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "next_authority_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "next_control_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "next_control_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "previous_manual_review_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "next_manual_review_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "next_manual_review_record_verified": {
          "const": true
        },
        "approval_performed_by_preview": {
          "const": false
        },
        "append_proof": {
          "$ref": "#/$defs/proof"
        },
        "source_control_and_raw_bindings_verified": {
          "const": true
        },
        "continuation_timing_ready": {
          "type": "boolean"
        },
        "requires_separate_knowledge_or_start": {
          "type": "boolean"
        },
        "handover_registered": {
          "const": false
        },
        "next_rule_enabled": {
          "const": false
        },
        "quarantine_cleared": {
          "const": false
        },
        "provider_calls": {
          "const": 0
        },
        "database_writes": {
          "const": 0
        },
        "research_admitted": {
          "const": false
        },
        "trading_permission": {
          "const": false
        },
        "raw_amounts_or_tax_text_output": {
          "const": false
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "append_proof": {
                "type": "object",
                "properties": {
                  "late_knowledge_event_count": {
                    "const": 0
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "continuation_timing_ready": {
                "const": true
              },
              "requires_separate_knowledge_or_start": {
                "const": false
              }
            }
          },
          "else": {
            "properties": {
              "continuation_timing_ready": {
                "const": false
              },
              "requires_separate_knowledge_or_start": {
                "const": true
              }
            }
          }
        }
      ]
    },
    "job_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "workspace_id",
        "provider_symbol",
        "kind",
        "body",
        "request_hash",
        "created_at",
        "valid_until"
      ],
      "properties": {
        "schema_version": {
          "const": "investor-action-review-job-request-v2"
        },
        "request_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "workspace_id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "provider_symbol": {
          "enum": [
            "VT.US",
            "BND.US"
          ]
        },
        "kind": {
          "const": "confirmation"
        },
        "body": {
          "$ref": "#/$defs/submit"
        },
        "request_hash": {
          "$ref": "common.schema.json#/$defs/hash"
        },
        "created_at": {
          "$ref": "common.schema.json#/$defs/instant"
        },
        "valid_until": {
          "$ref": "common.schema.json#/$defs/instant"
        }
      }
    }
  }
}
