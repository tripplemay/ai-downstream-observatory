{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etf-workbench.invalid/contracts/v1/investor-retained-monitor-history.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "actor_id", "model_id", "model_hash", "control_hash", "origin_checkpoint_id", "head_checkpoint_id", "head_checkpoint_sequence", "checkpoint_chain_hash", "original_actions_hash", "input_bindings", "checked_at", "source_valid_until", "purpose", "status", "original_inputs_replayed", "original_states_replayed", "original_knowledge_replayed", "reference_source_current_at_check", "corrected_source_evidence_verified", "current_source_eligibility_restored", "economic_correction_approved", "checkpoint_created", "monitoring_resumed", "historical_observations_rewritten", "trading_permission", "provider_calls", "database_writes", "distribution"],
  "properties": {
    "schema_version": {"const": "investor-retained-monitor-history-v1"},
    "workspace_id": {"$ref": "#/$defs/id"}, "actor_id": {"$ref": "#/$defs/id"}, "model_id": {"$ref": "#/$defs/id"},
    "model_hash": {"$ref": "#/$defs/hash"}, "control_hash": {"$ref": "#/$defs/hash"},
    "origin_checkpoint_id": {"$ref": "#/$defs/id"}, "head_checkpoint_id": {"$ref": "#/$defs/id"},
    "head_checkpoint_sequence": {"type": "integer", "minimum": 1, "maximum": 1000},
    "checkpoint_chain_hash": {"$ref": "#/$defs/hash"}, "original_actions_hash": {"$ref": "#/$defs/hash"},
    "input_bindings": {"type": "array", "minItems": 1, "maxItems": 1000, "items": {"$ref": "#/$defs/binding"}},
    "checked_at": {"type": "string", "format": "date-time"}, "source_valid_until": {"type": "string", "format": "date-time"},
    "purpose": {"const": "recorded_history_comparison_only"}, "status": {"const": "original_history_replayed_not_recovered"},
    "original_inputs_replayed": {"const": true}, "original_states_replayed": {"const": true}, "original_knowledge_replayed": {"const": true},
    "reference_source_current_at_check": {"const": true}, "corrected_source_evidence_verified": {"const": false},
    "current_source_eligibility_restored": {"const": false}, "economic_correction_approved": {"const": false},
    "checkpoint_created": {"const": false}, "monitoring_resumed": {"const": false}, "historical_observations_rewritten": {"const": false},
    "trading_permission": {"const": false}, "provider_calls": {"const": 0}, "database_writes": {"const": 0},
    "distribution": {"const": "private_owner_only_not_ai"}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 300},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "binding": {
      "type": "object", "additionalProperties": false,
      "required": ["checkpoint_id", "sequence", "checkpoint_hash", "input_id", "input_hash", "input_protocol", "projection_hash", "created_at", "valid_until"],
      "properties": {
        "checkpoint_id": {"$ref": "#/$defs/id"}, "sequence": {"type": "integer", "minimum": 1, "maximum": 1000},
        "checkpoint_hash": {"$ref": "#/$defs/hash"}, "input_id": {"$ref": "#/$defs/id"}, "input_hash": {"$ref": "#/$defs/hash"},
        "input_protocol": {"enum": ["investor-monitor-data-input-v1", "investor-monitor-data-input-v2", "investor-monitor-data-input-v3", "investor-monitor-data-input-v4", "investor-monitor-data-input-v5"]},
        "projection_hash": {"$ref": "#/$defs/hash"}, "created_at": {"type": "string", "format": "date-time"}, "valid_until": {"type": "string", "format": "date-time"}
      }
    }
  }
}
