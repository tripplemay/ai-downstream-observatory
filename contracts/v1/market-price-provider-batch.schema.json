{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://etf-workbench.invalid/contracts/v1/market-price-provider-batch.schema.json",
  "type":"object","required":["schema_version","batch","pages"],
  "properties":{
    "schema_version":{"const":"market-price-provider-batch-v1"},
    "batch":{
      "type":"object","required":["id","source_id","batch_type","scope","expected_pages","expected_rows","expected_publication_revision","source_mode","provider_capture_id"],
      "properties":{
        "id":{"$ref":"common.schema.json#/$defs/id"},"source_id":{"const":"provider:longport:prices"},"batch_type":{"const":"prices"},
        "scope":{"type":"string","pattern":"^provider:longport:prices:[a-f0-9]{64}$"},"expected_pages":{"const":1},
        "expected_rows":{"type":"integer","minimum":1,"maximum":124},
        "expected_publication_revision":{"type":"integer","minimum":0,"maximum":9007199254740991},
        "source_mode":{"const":"provider_observed"},"provider_capture_id":{"$ref":"common.schema.json#/$defs/id"}
      },"additionalProperties":false
    },
    "pages":{"type":"array","minItems":1,"maxItems":1,"items":{"$ref":"market-batch.schema.json#/properties/pages/items"}}
  },"additionalProperties":false
}
