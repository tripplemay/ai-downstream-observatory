{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etf-workbench.invalid/contracts/v1/investor-monitor-data-input-v4.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "model_id", "target_definition_hash", "source_qualification", "segments", "settings", "projection_hash", "created_at", "valid_until", "live_advice_eligible"],
  "properties": {
    "schema_version": {"const": "investor-monitor-data-input-v4"}, "workspace_id": {"$ref": "common.schema.json#/$defs/id"}, "model_id": {"$ref": "common.schema.json#/$defs/id"},
    "target_definition_hash": {"$ref": "common.schema.json#/$defs/hash"}, "source_qualification": {"const": "owner_reviewed_reconstructed"},
    "segments": {"type": "array", "minItems": 1, "maxItems": 3, "items": {
      "type": "object", "additionalProperties": false, "required": ["snapshot", "dataset_hash", "catalog_hash"],
      "properties": {"snapshot": {"$ref": "investor-monitor-source-snapshot-v2.schema.json"}, "dataset_hash": {"$ref": "common.schema.json#/$defs/hash"}, "catalog_hash": {"$ref": "common.schema.json#/$defs/hash"}}
    }},
    "settings": {"oneOf": [{"$ref": "investor-monitor-data-input.schema.json#/$defs/settings"}, {"$ref": "investor-monitor-data-input-v3.schema.json#/$defs/settings"}]},
    "projection_hash": {"$ref": "common.schema.json#/$defs/hash"}, "created_at": {"$ref": "investor-reference-plan.schema.json#/$defs/instant"},
    "valid_until": {"$ref": "investor-reference-plan.schema.json#/$defs/instant"}, "live_advice_eligible": {"const": false}
  }
}
