{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://etf-workbench.invalid/contracts/v1/bounded-cash-run.schema.json",
  "oneOf":[{"$ref":"#/$defs/input"},{"$ref":"#/$defs/result"},{"$ref":"#/$defs/comparisonInput"},{"$ref":"#/$defs/comparison"}],
  "$defs":{
    "id":{"$ref":"bounded-cash-buy.schema.json#/$defs/id"},"instant":{"$ref":"bounded-cash-buy.schema.json#/$defs/instant"},
    "hash":{"$ref":"bounded-cash-buy.schema.json#/$defs/hash"},"derived":{"$ref":"bounded-cash-buy.schema.json#/$defs/derived"},
    "signed":{"$ref":"bounded-cash-projection.schema.json#/$defs/signed"},"nullableSigned":{"$ref":"bounded-cash-projection.schema.json#/$defs/nullableSigned"},"nullableDerived":{"$ref":"bounded-cash-projection.schema.json#/$defs/nullableDerived"},
    "decisionPoint":{
      "type":"object","additionalProperties":false,"required":["decision_id","at","execute_at","expires_at"],
      "properties":{"decision_id":{"$ref":"#/$defs/id"},"at":{"$ref":"#/$defs/instant"},"execute_at":{"$ref":"#/$defs/instant"},"expires_at":{"$ref":"#/$defs/instant"}}
    },
    "executionObservation":{
      "type":"object","additionalProperties":false,"required":["listing_id","quote_id","close","observed_at","known_at","corporate_action_since_decision"],
      "properties":{"listing_id":{"$ref":"#/$defs/id"},"quote_id":{"$ref":"#/$defs/id"},"close":{"$ref":"bounded-cash-buy.schema.json#/$defs/number"},"observed_at":{"$ref":"#/$defs/instant"},"known_at":{"$ref":"#/$defs/instant"},"corporate_action_since_decision":{"type":"boolean"}}
    },
    "frame":{
      "type":"object","additionalProperties":false,"required":["at","marks","execution_observations"],
      "properties":{"at":{"$ref":"#/$defs/instant"},"marks":{"$ref":"bounded-cash-projection.schema.json#/$defs/marks"},"execution_observations":{"type":"array","maxItems":20,"items":{"$ref":"#/$defs/executionObservation"}}}
    },
    "frames":{"type":"array","minItems":1,"maxItems":30000,"items":{"$ref":"#/$defs/frame"}},
    "decisionPoints":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/decisionPoint"}},
    "side":{
      "type":"object","additionalProperties":false,"required":["declaration","program"],
      "properties":{"declaration":{"$ref":"bounded-cash-journal.schema.json#/$defs/declaration"},"program":{"$ref":"bounded-cash-projection.schema.json#/$defs/program"}}
    },
    "input":{
      "type":"object","additionalProperties":false,"required":["schema_version","qualification","declaration","program","frames","decision_points"],
      "properties":{"schema_version":{"const":"bounded-cash-run-input-v1"},"qualification":{"const":"synthetic_test_only"},"declaration":{"$ref":"bounded-cash-journal.schema.json#/$defs/declaration"},"program":{"$ref":"bounded-cash-projection.schema.json#/$defs/program"},"frames":{"$ref":"#/$defs/frames"},"decision_points":{"$ref":"#/$defs/decisionPoints"}}
    },
    "decisionRecord":{
      "type":"object","additionalProperties":false,"required":["decision_id","before_head_hash","after_head_hash","decision"],
      "properties":{"decision_id":{"$ref":"#/$defs/id"},"before_head_hash":{"$ref":"#/$defs/hash"},"after_head_hash":{"$ref":"#/$defs/hash"},"decision":{"$ref":"bounded-cash-projection.schema.json#/$defs/decision"}}
    },
    "curvePoint":{
      "type":"object","additionalProperties":false,"required":["at","revision","state_hash","nav_cny","settled_cash_cny","reserved_cny","position_value_cny","total_contributions_cny","units","unit_nav","total_return","drawdown"],
      "properties":{"at":{"$ref":"#/$defs/instant"},"revision":{"type":"integer","minimum":0,"maximum":512},"state_hash":{"$ref":"#/$defs/hash"},"nav_cny":{"$ref":"#/$defs/derived"},"settled_cash_cny":{"$ref":"#/$defs/derived"},"reserved_cny":{"$ref":"#/$defs/derived"},"position_value_cny":{"$ref":"#/$defs/derived"},"total_contributions_cny":{"$ref":"#/$defs/derived"},"units":{"$ref":"#/$defs/derived"},"unit_nav":{"$ref":"#/$defs/nullableDerived"},"total_return":{"$ref":"#/$defs/nullableSigned"},"drawdown":{"$ref":"#/$defs/nullableDerived"}}
    },
    "result":{
      "type":"object","additionalProperties":false,"required":["schema_version","qualification","implementation_hash","input_hash","program_hash","decision_policy_compliance_verified","valuation_basis","journal","decisions","curve","event_valuation","sampled_max_drawdown","fees_cny","rounding_cny","total_debited_cny","execution_failure_count","all_planned_batches_terminal","live_advice_eligible","result_hash"],
      "properties":{"schema_version":{"const":"bounded-cash-run-result-v1"},"qualification":{"const":"synthetic_test_only"},"implementation_hash":{"$ref":"#/$defs/hash"},"input_hash":{"$ref":"#/$defs/hash"},"program_hash":{"$ref":"#/$defs/hash"},"decision_policy_compliance_verified":{"const":true},"valuation_basis":{"const":"terminal_processing_not_execution_settlement"},"journal":{"$ref":"bounded-cash-journal.schema.json#/$defs/journal"},"decisions":{"type":"array","maxItems":128,"items":{"$ref":"#/$defs/decisionRecord"}},"curve":{"type":"array","minItems":1,"maxItems":30000,"items":{"$ref":"#/$defs/curvePoint"}},"event_valuation":{"$ref":"bounded-cash-projection.schema.json#/$defs/report"},"sampled_max_drawdown":{"$ref":"#/$defs/nullableDerived"},"fees_cny":{"$ref":"#/$defs/derived"},"rounding_cny":{"$ref":"#/$defs/derived"},"total_debited_cny":{"$ref":"#/$defs/derived"},"execution_failure_count":{"type":"integer","minimum":0,"maximum":10240},"all_planned_batches_terminal":{"const":true},"live_advice_eligible":{"const":false},"result_hash":{"$ref":"#/$defs/hash"}}
    },
    "comparisonInput":{
      "type":"object","additionalProperties":false,"required":["schema_version","qualification","candidate","benchmark","frames","decision_points"],
      "properties":{"schema_version":{"const":"bounded-cash-comparison-input-v1"},"qualification":{"const":"synthetic_test_only"},"candidate":{"$ref":"#/$defs/side"},"benchmark":{"$ref":"#/$defs/side"},"frames":{"$ref":"#/$defs/frames"},"decision_points":{"$ref":"#/$defs/decisionPoints"}}
    },
    "comparison":{
      "type":"object","additionalProperties":false,"required":["schema_version","qualification","implementation_hash","input_hash","candidate","benchmark","same_recorded_cash_flows","same_execution_policy","benchmark_kind","end_nav_difference_cny","excess_cash_flow_adjusted_return","parameters_independently_preregistered","live_advice_eligible","comparison_hash"],
      "properties":{"schema_version":{"const":"bounded-cash-comparison-v1"},"qualification":{"const":"synthetic_test_only"},"implementation_hash":{"$ref":"#/$defs/hash"},"input_hash":{"$ref":"#/$defs/hash"},"candidate":{"$ref":"#/$defs/result"},"benchmark":{"$ref":"#/$defs/result"},"same_recorded_cash_flows":{"const":true},"same_execution_policy":{"const":true},"benchmark_kind":{"const":"simulated_cash_only_market_portfolio_not_index_or_actual_execution"},"end_nav_difference_cny":{"$ref":"#/$defs/signed"},"excess_cash_flow_adjusted_return":{"$ref":"#/$defs/nullableSigned"},"parameters_independently_preregistered":{"const":false},"live_advice_eligible":{"const":false},"comparison_hash":{"$ref":"#/$defs/hash"}}
    }
  }
}
