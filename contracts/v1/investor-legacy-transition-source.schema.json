{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etf-workbench.invalid/contracts/v1/investor-legacy-transition-source.schema.json",
  "$defs": {
    "transition_ref": {
      "type": "object", "additionalProperties": false, "required": ["id", "content_hash"],
      "properties": {"id": {"$ref": "common.schema.json#/$defs/id"}, "content_hash": {"$ref": "common.schema.json#/$defs/hash"}}
    },
    "request": {
      "type": "object", "additionalProperties": false, "required": ["transition_id", "transition_hash", "expected_revision", "idempotency_key"],
      "properties": {"transition_id": {"$ref": "common.schema.json#/$defs/id"}, "transition_hash": {"$ref": "common.schema.json#/$defs/hash"},
        "expected_revision": {"$ref": "investor-legacy-transition-workflow.schema.json#/$defs/revision"}, "idempotency_key": {"$ref": "common.schema.json#/$defs/id"}}
    },
    "admission": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "admission_id", "workspace_id", "workspace_revision", "model_id", "transition_id", "transition_hash", "input_id", "input_hash", "request", "request_hash", "created_at", "valid_until", "monitor_source_registered", "monitoring_activated", "trading_permission", "raw_ai_sharing", "provider_calls"],
      "properties": {
        "schema_version": {"const": "investor-legacy-transition-source-admission-v1"}, "admission_id": {"$ref": "common.schema.json#/$defs/id"}, "workspace_id": {"$ref": "common.schema.json#/$defs/id"},
        "workspace_revision": {"$ref": "investor-legacy-transition-workflow.schema.json#/$defs/revision"}, "model_id": {"$ref": "common.schema.json#/$defs/id"},
        "transition_id": {"$ref": "common.schema.json#/$defs/id"}, "transition_hash": {"$ref": "common.schema.json#/$defs/hash"},
        "input_id": {"$ref": "common.schema.json#/$defs/id"}, "input_hash": {"$ref": "common.schema.json#/$defs/hash"},
        "request": {"$ref": "#/$defs/request"}, "request_hash": {"$ref": "common.schema.json#/$defs/hash"},
        "created_at": {"$ref": "investor-legacy-transition-workflow.schema.json#/$defs/instant"}, "valid_until": {"$ref": "investor-legacy-transition-workflow.schema.json#/$defs/instant"},
        "monitor_source_registered": {"const": true}, "monitoring_activated": {"const": false}, "trading_permission": {"const": false}, "raw_ai_sharing": {"const": false}, "provider_calls": {"const": 0}
      }
    }
  }
}
