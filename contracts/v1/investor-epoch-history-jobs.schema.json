{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"investor-epoch-history-jobs.schema.json",
  "$defs":{
    "id":{"type":"string","minLength":1,"maxLength":160},"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"at":{"type":"string","format":"date-time","pattern":"Z$"},
    "ref":{"type":"object","additionalProperties":false,"required":["id","content_hash"],"properties":{"id":{"$ref":"#/$defs/id"},"content_hash":{"$ref":"#/$defs/hash"}}},
    "submit":{"type":"object","additionalProperties":false,
      "required":["schema_version","epoch_id","planned_at","expected_plan_hash","expected_revision","idempotency_key","max_calls","acknowledgements"],
      "properties":{"schema_version":{"const":"investor-epoch-history-submit-v1"},"epoch_id":{"$ref":"#/$defs/id"},"planned_at":{"$ref":"#/$defs/at"},"expected_plan_hash":{"$ref":"#/$defs/hash"},
        "expected_revision":{"type":"integer","minimum":0,"maximum":9007199254740990},"idempotency_key":{"type":"string","minLength":8,"maxLength":160},"max_calls":{"type":"integer","minimum":1,"maximum":4},
        "acknowledgements":{"type":"object","additionalProperties":false,"required":["historical_not_live","old_attempts_unchanged","bounded_download_only","no_trading"],
          "properties":{"historical_not_live":{"const":true},"old_attempts_unchanged":{"const":true},"bounded_download_only":{"const":true},"no_trading":{"const":true}}}}},
    "request":{"type":"object","additionalProperties":false,
      "required":["schema_version","request_id","workspace_id","model_id","actor_id","body","request_hash","plan","authorized_calls","created_at","valid_until","trading_permission"],
      "properties":{"schema_version":{"const":"investor-epoch-history-request-v1"},"request_id":{"$ref":"#/$defs/id"},"workspace_id":{"$ref":"#/$defs/id"},"model_id":{"$ref":"#/$defs/id"},"actor_id":{"$ref":"#/$defs/id"},
        "body":{"$ref":"#/$defs/submit"},"request_hash":{"$ref":"#/$defs/hash"},"plan":{"$ref":"investor-epoch-history-plan.schema.json"},"authorized_calls":{"type":"integer","minimum":1,"maximum":4},
        "created_at":{"$ref":"#/$defs/at"},"valid_until":{"$ref":"#/$defs/at"},"trading_permission":{"const":false}}},
    "attempt":{"type":"object","additionalProperties":false,
      "required":["schema_version","attempt_id","slot","request","job_id","fencing_token","created_at","valid_until","source_fence","implementation_hash","network_outcome_known","trading_permission"],
      "properties":{"schema_version":{"const":"investor-epoch-history-attempt-v1"},"attempt_id":{"$ref":"#/$defs/id"},"slot":{"$ref":"#/$defs/ref"},"request":{"$ref":"#/$defs/ref"},"job_id":{"$ref":"#/$defs/id"},
        "fencing_token":{"type":"integer","minimum":1},"created_at":{"$ref":"#/$defs/at"},"valid_until":{"$ref":"#/$defs/at"},"source_fence":{"$ref":"#/$defs/hash"},"implementation_hash":{"$ref":"#/$defs/hash"},
        "network_outcome_known":{"const":false},"trading_permission":{"const":false}}},
    "run":{"type":"object","additionalProperties":false,
      "required":["schema_version","run_id","slot","request","job_id","fencing_token","attempt_id","capture_id","receipt_hash","status","code","created_at","valid_until","source_fence","trading_permission"],
      "properties":{"schema_version":{"const":"investor-epoch-history-run-v1"},"run_id":{"$ref":"#/$defs/id"},"slot":{"$ref":"#/$defs/ref"},"request":{"$ref":"#/$defs/ref"},"job_id":{"$ref":"#/$defs/id"},"fencing_token":{"type":"integer","minimum":1},
        "attempt_id":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"capture_id":{"anyOf":[{"$ref":"#/$defs/id"},{"type":"null"}]},"receipt_hash":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},
        "status":{"enum":["collected","already_available","superseded","blocked_predecessor","transport_unknown"]},"code":{"enum":["EPOCH_HISTORY_COLLECTED","EPOCH_HISTORY_ALREADY_AVAILABLE","EPOCH_HISTORY_SUPERSEDED","EPOCH_HISTORY_BLOCKED_PREDECESSOR","EPOCH_HISTORY_TRANSPORT_UNKNOWN"]},
        "created_at":{"$ref":"#/$defs/at"},"valid_until":{"$ref":"#/$defs/at"},"source_fence":{"anyOf":[{"$ref":"#/$defs/hash"},{"type":"null"}]},"trading_permission":{"const":false}}}
  }
}
