{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etf-workbench.invalid/contracts/v1/investor-monitor-data-input.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "model_id", "target_definition_hash", "source_qualification", "segments", "settings", "projection_hash", "created_at", "valid_until", "live_advice_eligible"],
  "properties": {
    "schema_version": {"const": "investor-monitor-data-input-v1"},
    "workspace_id": {"$ref": "common.schema.json#/$defs/id"}, "model_id": {"$ref": "common.schema.json#/$defs/id"},
    "target_definition_hash": {"$ref": "common.schema.json#/$defs/hash"}, "source_qualification": {"const": "owner_reviewed_reconstructed"},
    "segments": {"type": "array", "minItems": 1, "maxItems": 3, "items": {"type": "object", "required": ["snapshot", "dataset_hash", "catalog_hash"], "properties": {
      "snapshot": {"allOf": [{"$ref": "investor-data-snapshot.schema.json"}, {"type": "object", "properties": {"mode": {"const": "reconstructed"}}}]},
      "dataset_hash": {"$ref": "common.schema.json#/$defs/hash"}, "catalog_hash": {"$ref": "common.schema.json#/$defs/hash"}
    }, "additionalProperties": false}},
    "settings": {"$ref": "#/$defs/settings"}, "projection_hash": {"$ref": "common.schema.json#/$defs/hash"},
    "created_at": {"$ref": "investor-reference-plan.schema.json#/$defs/instant"},
    "valid_until": {"$ref": "investor-reference-plan.schema.json#/$defs/instant"}, "live_advice_eligible": {"const": false}
  },
  "$defs": {
    "settings": {"type": "object", "required": ["policy", "funding_intent", "max_quote_age_seconds"], "properties": {
      "policy": {"$ref": "investor-model-monitor.schema.json#/properties/policy"},
      "funding_intent": {"$ref": "investor-model-monitor.schema.json#/properties/funding_intent"},
      "max_quote_age_seconds": {"type": "integer", "minimum": 1, "maximum": 604800}
    }, "additionalProperties": false}
  }
}
