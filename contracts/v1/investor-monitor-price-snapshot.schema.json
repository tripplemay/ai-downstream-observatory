{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://etf-workbench.invalid/contracts/v1/investor-monitor-price-snapshot.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "workspace_id",
    "created_at",
    "range_start",
    "range_end",
    "mode",
    "capture_refs",
    "review_refs",
    "publication_times",
    "universe_basis",
    "review_basis",
    "external_ai_authorized",
    "live_advice_eligible",
    "use_scope"
  ],
  "properties": {
    "schema_version": {
      "const": "investor-monitor-price-snapshot-v1"
    },
    "workspace_id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "created_at": {
      "$ref": "common.schema.json#/$defs/instant"
    },
    "range_start": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "range_end": {
      "$ref": "common.schema.json#/$defs/date"
    },
    "mode": {
      "const": "reconstructed"
    },
    "capture_refs": {
      "type": "array",
      "contains": {"type": "object", "required": ["kind"], "properties": {"kind": {"const": "confirmed_sdk"}}},
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "capture_id",
              "receipt_hash",
              "kind",
              "projection_sha256"
            ],
            "properties": {
              "capture_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "receipt_hash": {
                "$ref": "common.schema.json#/$defs/hash"
              },
              "kind": {
                "const": "historical_sdk"
              },
              "projection_sha256": {
                "$ref": "common.schema.json#/$defs/hash"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "capture_id",
              "receipt_hash",
              "kind",
              "payload_sha256"
            ],
            "properties": {
              "capture_id": {
                "$ref": "common.schema.json#/$defs/id"
              },
              "receipt_hash": {
                "$ref": "common.schema.json#/$defs/hash"
              },
              "kind": {
                "const": "confirmed_sdk"
              },
              "payload_sha256": {
                "$ref": "common.schema.json#/$defs/hash"
              }
            },
            "additionalProperties": false
          }
        ]
      }
    },
    "review_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3000,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "review_id",
          "review_hash",
          "source_id",
          "source_hash"
        ],
        "properties": {
          "review_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "review_hash": {
            "$ref": "common.schema.json#/$defs/hash"
          },
          "source_id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "source_hash": {
            "$ref": "common.schema.json#/$defs/hash"
          }
        },
        "additionalProperties": false
      }
    },
    "publication_times": {
      "const": "mixed_assumptions_and_sdk_callback_receipt_not_provider_published_at"
    },
    "universe_basis": {
      "const": "retrospectively_selected_not_survivorship_free"
    },
    "review_basis": {
      "const": "owner_reviewed_not_provider_certified"
    },
    "external_ai_authorized": {
      "const": false
    },
    "live_advice_eligible": {
      "const": false
    },
    "use_scope": {
      "const": "monitor_only"
    }
  },
  "additionalProperties": false
}
